import pygame
import random

# Initialize the pygame library
pygame.init()

# Set up display
width = 800
height = 600
screen = pygame.display.set_mode((width, height))
pygame.display.set_caption("Ping Pong Game")

# Set up colors
WHITE = (255, 255, 255)
BLACK = (0, 0, 0)
RED = (255, 0, 0)

# Define the paddle dimensions and speed
paddle_width = 15
paddle_height = 100
paddle_speed = 10

# Ball dimensions and speed
ball_width = 15
ball_speed_x = 7
ball_speed_y = 7

# Set up font for scoring
font = pygame.font.SysFont("Arial", 30)

# Initialize paddles and ball
player1_x = 50
player1_y = (height // 2) - (paddle_height // 2)
player2_x = width - 50 - paddle_width
player2_y = (height // 2) - (paddle_height // 2)

ball_x = width // 2 - ball_width // 2
ball_y = height // 2 - ball_width // 2

player1_score = 0
player2_score = 0

# Clock object to manage frame rate
clock = pygame.time.Clock()

# Game loop
running = True
while running:
    screen.fill(BLACK)  # Fill screen with black color

    # Event handling
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    # Get the state of the keyboard
    keys = pygame.key.get_pressed()

    # Player 1 movement (up/down keys)
    if keys[pygame.K_w] and player1_y > 0:
        player1_y -= paddle_speed
    if keys[pygame.K_s] and player1_y < height - paddle_height:
        player1_y += paddle_speed

    # Player 2 movement (up/down arrows)
    if keys[pygame.K_UP] and player2_y > 0:
        player2_y -= paddle_speed
    if keys[pygame.K_DOWN] and player2_y < height - paddle_height:
        player2_y += paddle_speed

    # Ball movement
    ball_x += ball_speed_x
    ball_y += ball_speed_y

    # Ball collision with top and bottom walls
    if ball_y <= 0 or ball_y >= height - ball_width:
        ball_speed_y = -ball_speed_y

    # Ball collision with paddles
    if (ball_x <= player1_x + paddle_width and player1_y < ball_y + ball_width and player1_y + paddle_height > ball_y) or \
       (ball_x + ball_width >= player2_x and player2_y < ball_y + ball_width and player2_y + paddle_height > ball_y):
        ball_speed_x = -ball_speed_x

    # Ball out of bounds (left or right)
    if ball_x <= 0:
        player2_score += 1
        ball_x = width // 2 - ball_width // 2
        ball_y = height // 2 - ball_width // 2
        ball_speed_x = -ball_speed_x
        ball_speed_y = random.choice([7, -7])

    if ball_x >= width - ball_width:
        player1_score += 1
        ball_x = width // 2 - ball_width // 2
        ball_y = height // 2 - ball_width // 2
        ball_speed_x = -ball_speed_x
        ball_speed_y = random.choice([7, -7])

    # Draw paddles and ball
    pygame.draw.rect(screen, WHITE, (player1_x, player1_y, paddle_width, paddle_height))
    pygame.draw.rect(screen, WHITE, (player2_x, player2_y, paddle_width, paddle_height))
    pygame.draw.ellipse(screen, WHITE, (ball_x, ball_y, ball_width, ball_width))

    # Display scores
    score_text = font.render(f"Player 1: {player1_score}  Player 2: {player2_score}", True, WHITE)
    screen.blit(score_text, (width // 2 - score_text.get_width() // 2, 20))

    # Update the screen
    pygame.display.flip()

    # Frame rate control
    clock.tick(60)

# Quit pygame
pygame.quit()
